# ==============================================
# APPLICATION CONFIGURATION
# ==============================================           
APP_URL=http://192.168.1.22:8000       # APP_URL=http://localhost      
APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:Vu5h6AJnke8lsJshMDyr/w6uSENNsPtjuyBWOnmkf5w=
APP_DEBUG=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file             #database(optional)
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# For local development: DB_HOST=127.0.0.1
# For Docker: DB_HOST=mysql

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quizzly_spa
DB_USERNAME=root
DB_PASSWORD=

# ==============================================
# SESSION & CACHE CONFIGURATION
# ==============================================

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Queue options:
# - database: Simple, no extra setup needed
# - sync: Runs jobs immediately (testing)
# - redis: Recommended for production (requires queue worker via php artisan queue:work)
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

CACHE_STORE=database
# CACHE_PREFIX=

# ==============================================
# REDIS CONFIGURATION
# ==============================================
# For local development: REDIS_HOST=127.0.0.1
# For Docker: REDIS_HOST=redis

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================
# MAIL CONFIGURATION
# ==============================================

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================
# REVERB WEBSOCKET CONFIGURATION
# ==============================================
# Run: php artisan reverb:install (if not already installed)
#
# REVERB_HOST: Where the Reverb server listens
#   - "0.0.0.0" = Listen on all network interfaces (for network access)
#   - "127.0.0.1" = Listen on localhost only
#   - "reverb" = For Docker container name
#
# VITE_REVERB_HOST: Where browsers connect to Reverb
#   - "localhost" = For local development only
#   - "192.168.1.22" = Your network IP (for network deployment)
#   - Server IP or domain for production

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=619048
REVERB_APP_KEY=f3caayht3zscr7k1tgyc
REVERB_APP_SECRET=7jhymofsjz04gt2hze4q
REVERB_HOST="127.0.0.1"                   # Server listens on all interfaces
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="192.168.1.22"           # Clients connect to this IP (change to your IP)
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

